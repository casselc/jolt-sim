index 00000000..5882f5a9
--- /dev/null
+++ b/test/chez/alloc-baseline.edn
@@ -0,0 +1 @@
+{"assoc-small-map" 576160, "bit-and-mask" 160, "generic-add" 160, "map-filter-reduce" 1772992, "str-concat" 224288, "unchecked-byte" 1760336, "unchecked-short" 1760992, "vec-range-10" 2674192}
\ No newline at end of file
diff --git a/test/chez/alloc-gate.clj b/test/chez/alloc-gate.clj
new file mode 100644
index 00000000..b6243be6
--- /dev/null
+++ b/test/chez/alloc-gate.clj
@@ -0,0 +1,91 @@
+(ns alloc-gate
+  "Allocation regression gate.
+
+  The repo has no wall-clock assertions in its default gates, and for good
+  reason: a timing floor is flaky on loaded CI. Allocation is not. Chez's
+  cumulative allocation counter answers a different, sharper question — did this
+  change make a hot path allocate more? — and answers it with a number that does
+  not move run to run, so the gate needs no repeats, no medians and no spread
+  analysis.
+
+  The counter is jolt.host/bytes-allocated-total (Chez sstats-bytes), which is
+  monotone. jolt.host/bytes-allocated is the LIVE HEAP and is the wrong
+  primitive here: a collection inside the measured window makes its difference
+  negative.
+
+  What this catches: boxing that was previously avoided, a primitive that
+  stopped being a primitive, an intermediate sequence that used to be fused.
+  Each of those is inside the noise of any timing gate.
+
+  What it does NOT catch: work that got slower without allocating more — a
+  generic dispatch replacing a primitive of the same allocation profile, worse
+  cache behaviour, more instructions. Allocation is a proxy, not a cost model.
+
+  Usage:
+    make allocgate                                       compare to baseline
+    ALLOC_GATE_RECORD=1 bin/joltc test/chez/alloc-gate.clj  rewrite the baseline"
+  (:require [jolt.host :as host]
+            [clojure.string :as str]))
+
+(def ^:private baseline-path "test/chez/alloc-baseline.edn")
+
+;; Allowed growth before a case fails. The counter is near-exact (the collector's
+;; accounting granularity moves it by a few hundred bytes in ~14 MB), so this is
+;; not a noise allowance — it is slack for unrelated compiler drift between
+;; commits.
+(def ^:private tolerance 0.02)
+
+(defn- measure
+  "Bytes allocated by running (f) `n` times, net of the harness loop."
+  [n f]
+  (let [before (host/bytes-allocated-total)]
+    (dotimes [_ n] (f))
+    (- (host/bytes-allocated-total) before)))
+
+(def ^:private cases
+  [["vec-range-10"        1000 #(vec (range 10))]
+   ["unchecked-byte"     10000 #(unchecked-byte 200)]
+   ["unchecked-short"    10000 #(unchecked-short 40000)]
+   ["bit-and-mask"       10000 #(bit-and 200 0xff)]
+   ["generic-add"        10000 #(+ 1000000 2000000)]
+   ["str-concat"          1000 #(str "a" "b" "c")]
+   ["map-filter-reduce"    200 #(reduce + (filter even? (map inc (range 50))))]
+   ["assoc-small-map"     1000 #(assoc {:a 1 :b 2} :c 3)]])
+
+(defn- run-all []
+  (reduce (fn [acc [name n f]] (assoc acc name (measure n f))) {} cases))
+
+(defn -main [& _]
+  (let [record? (= "1" (System/getenv "ALLOC_GATE_RECORD"))
+        actual (run-all)]
+    (if record?
+      (do (spit baseline-path (pr-str (into (sorted-map) actual)))
+          (println "recorded" (count actual) "cases to" baseline-path))
+      (let [baseline (read-string (slurp baseline-path))
+            rows (for [[name got] (sort actual)
+                       :let [want (get baseline name)]]
+                   (cond
+                     (nil? want) [:new name got nil]
+                     (> got (* want (+ 1.0 tolerance))) [:fail name got want]
+                     (< got (* want (- 1.0 tolerance))) [:improved name got want]
+                     :else [:ok name got want]))
+            failures (filter #(= :fail (first %)) rows)]
+        (doseq [[status name got want] rows]
+          (println (format "  [%s] %-20s %10d bytes%s"
+                           (str/upper-case (clojure.core/name status))
+                           name got
+                           (if want
+                             (let [pct (if (zero? want)
+                                         0.0
+                                         (* 100.0 (/ (- got want) (double want))))]
+                               (str "  (baseline " want ", "
+                                    (if (neg? pct) "" "+")
+                                    (format "%.1f" pct) "%)"))
+                             "  (no baseline)"))))
+        (println)
+        (if (seq failures)
+          (do (println "alloc gate:" (count failures) "case(s) allocate more than baseline")
+              (System/exit 1))
+          (println "alloc gate:" (count rows) "case(s) within tolerance"))))))
+
+(-main)
diff --git a/test/chez/unit.edn b/test/chez/unit.edn
index a71b7af0..fc91228a 100644
--- a/test/chez/unit.edn
+++ b/test/chez/unit.edn
@@ -709,6 +709,13 @@
   {:suite "telemetry" :expr "(>= (jolt.host/cpu-nanos) 0)" :expected "true"}
   {:suite "telemetry" :expr "(>= (jolt.host/real-nanos) 0)" :expected "true"}
   {:suite "telemetry" :expr "(>= (jolt.host/gc-count) 0)" :expected "true"}
+  ;; bytes-allocated-total is CUMULATIVE and monotone: a collection inside the
+  ;; measured window cannot make a difference across it negative, which is what
+  ;; makes it usable as a regression counter. bytes-allocated is the live heap
+  ;; and does not have that property.
+  {:suite "telemetry" :expr "(>= (jolt.host/bytes-allocated-total) 0)" :expected "true"}
+  {:suite "telemetry" :expr "(let [a (jolt.host/bytes-allocated-total) _ (doall (map inc (range 2000))) b (jolt.host/bytes-allocated-total)] (> b a))" :expected "true"}
+  {:suite "telemetry" :expr "(let [a (jolt.host/bytes-allocated-total) _ (doall (map inc (range 20000))) b (jolt.host/bytes-allocated-total)] (>= b a))" :expected "true"}
   {:suite "telemetry" :expr "(>= (jolt.host/gc-cpu-nanos) 0)" :expected "true"}
   {:suite "telemetry" :expr "(>= (jolt.host/gc-real-nanos) 0)" :expected "true"}
   {:suite "telemetry" :expr "(>= (jolt.host/gc-bytes) 0)" :expected "true"}
