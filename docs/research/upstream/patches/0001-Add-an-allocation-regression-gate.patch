+ci: submodules values corpus unit allocgate grenadine mvnhttp depssmoke depsunit smoke tracesmoke buildsmoke buildlibsmoke staticnativesmoke sci cts ffi transient infer wp devirt fieldread numwp fieldnum fieldjoin contagion protoret pic narrow directlink unitcontext numeric oparity mathfl flarr inline inline-body dcerefs shakelocal manifestcheck irvalidate devbootsmoke gatebootsmoke aotcachesmoke aotfingerprint compilepathsmoke makefilesmoke certify
 	@echo "OK: CI gates passed"
 
 # Self-host fixpoint: bootstrap.ss rebuild == checked-in seed.
@@ -398,6 +398,14 @@ shakelocal: testbin
 # Runtime load-manifest drift guard: cli.ss (the live entry) and bootstrap.ss
 # (the seed rebuilder's reduced set) hand-mirror build.ss's bld-runtime-manifest;
 # this diffs them so a load added to one but not the other fails the gate.
+# Allocation regression gate: bytes allocated by eight representative forms,
+# against test/chez/alloc-baseline.edn. Unlike printperf/aotcacheperf this IS in
+# `ci` — the counter is Chez's cumulative allocation total, which does not move
+# with machine load, so it carries none of the flakiness a timing floor would.
+# ALLOC_GATE_RECORD=1 rewrites the baseline.
+allocgate:
+	@bin/joltc test/chez/alloc-gate.clj
+
 manifestcheck:
 	@sh host/chez/manifest-check.sh
 
