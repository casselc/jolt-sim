#!/bin/sh
# verify-capability-rules — gate for the capability-tier rule-set prototypes.
#
# Mirrors the bin/verify-* pattern used in jolt-bytes, jolt-bencode and
# jolt-hako: run every check, report each, fail the gate if any fails.
#
# What each stage establishes, and what it does NOT:
#
#   queries      mode_checker.py against jolt-hako proofs/prolog/queries.json --
#                the 9 recorded queries with their recorded expected answers.
#                SPOT CHECKS. These passed at a rule set carrying 1051 unsound
#                acceptances, so passing this stage alone means little.
#   equivalence  equivalence.py against a transcription of ownership.pl step/3
#                over EVERY operation sequence to depth 10. This is the load-
#                bearing stage: it is a differential test against the
#                specification's own semantics, not its examples.
#   controlflow  branching and loops. Rules and expectations are both authored
#                in this repository, so this is a consistency check, not
#                differential evidence.
#   multicap     names, aliasing, moves, and function signatures.
#   refinement   the OTHER half of the capability tier: refinements over
#                QF-LIA on jolt.bytes/Window, Cursor, read-window and
#                jolt.bencode/decode, with a self-contained decision
#                procedure. Types are HAND-ANNOTATED and CHECKED, not
#                inferred. Includes the solver's own self-test.
#   higherorder  the sans-io driver, which takes the step function as an
#                ARGUMENT -- the first of Q2's two unresolved higher-order
#                risks.
#   transducer   composition of refined steps -- the second risk, and the
#                one that needs machinery the design does not yet name.
#
# Nonclaims: bounded to depth 10; one capability domain (the hako codec
# buffer) for the mode stages; straight-line and structured control flow only
# for the mode stages; Python prototypes modelling a rule set, not a checker
# over Jolt IR. The refinement stages CHECK hand-written annotations and infer
# nothing, and their solver is sound-for-validity but incomplete over the
# integers (Fourier-Motzkin runs over the rationals).
#
# Usage:  ./verify-capability-rules
set -eu

cd "$(dirname "$0")"
PY="${PYTHON:-python3}"
DEPTH="${DEPTH:-10}"

fails=0
run() {
    label="$1"; shift
    printf '=== %s ===\n' "$label"
    if "$@"; then
        printf '%s\n\n' "--- $label: OK"
    else
        printf '%s\n\n' "--- $label: FAILED"
        fails=$((fails + 1))
    fi
}

run "queries (spot checks, not sufficient alone)" "$PY" mode_checker.py
run "equivalence vs ownership.pl, depth $DEPTH" "$PY" equivalence.py "$DEPTH"
run "control flow (consistency check)"           "$PY" controlflow.py
run "multiple capabilities and aliasing"         "$PY" multicap.py
run "refinements (first-order, E3 surface)"      "$PY" refinement.py
run "higher-order: the sans-io driver"           "$PY" higherorder.py
run "higher-order: transducers"                  "$PY" transducer.py

if [ "$fails" -eq 0 ]; then
    echo "capability-rule gate: all stages passed"
    exit 0
fi
echo "capability-rule gate: $fails stage(s) FAILED"
exit 1
