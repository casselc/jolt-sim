; One alarm, exact integer time/deadline domain 0..3, and four operations.
; SAT would witness early, duplicate, missed-due, or post-cancel delivery.
; Chiasmus adds check-sat/model retrieval.
(declare-datatypes () ((Status absent pending delivered cancelled)))
(declare-datatypes () ((Op noop register cancel advance)))
(declare-const deadline Int)
(declare-const time0 Int)
(declare-const status0 Status)
(declare-const deliveries0 Int)

(declare-const op0 Op)
(declare-const advance0 Int)
(declare-const time1 Int)
(declare-const status1 Status)
(declare-const deliveries1 Int)
(declare-const op1 Op)
(declare-const advance1 Int)
(declare-const time2 Int)
(declare-const status2 Status)
(declare-const deliveries2 Int)
(declare-const op2 Op)
(declare-const advance2 Int)
(declare-const time3 Int)
(declare-const status3 Status)
(declare-const deliveries3 Int)
(declare-const op3 Op)
(declare-const advance3 Int)
(declare-const time4 Int)
(declare-const status4 Status)
(declare-const deliveries4 Int)

(assert (! (and (<= 0 deadline) (<= deadline 3)
                (<= 0 time0) (<= time0 3)
                (= status0 absent) (= deliveries0 0))
           :named initial_domain))

(assert (! (and
  (<= 0 advance0) (<= advance0 3)
  (=> (= op0 advance) (>= advance0 time0))
  (=> (= op0 register) (= status0 absent))
  (= time1 (ite (= op0 advance) advance0 time0))
  (= status1
     (ite (= op0 register)
          (ite (<= deadline time0) delivered pending)
          (ite (= op0 cancel)
               (ite (= status0 pending) cancelled status0)
               (ite (= op0 advance)
                    (ite (and (= status0 pending)
                              (<= deadline advance0))
                         delivered status0)
                    status0))))
  (= deliveries1
     (+ deliveries0
        (ite (or (and (= op0 register)
                      (= status0 absent)
                      (<= deadline time0))
                 (and (= op0 advance)
                      (= status0 pending)
                      (<= deadline advance0)))
             1 0))))
  :named transition_0))

(assert (! (and
  (<= 0 advance1) (<= advance1 3)
  (=> (= op1 advance) (>= advance1 time1))
  (=> (= op1 register) (= status1 absent))
  (= time2 (ite (= op1 advance) advance1 time1))
  (= status2
     (ite (= op1 register)
          (ite (<= deadline time1) delivered pending)
          (ite (= op1 cancel)
               (ite (= status1 pending) cancelled status1)
               (ite (= op1 advance)
                    (ite (and (= status1 pending)
                              (<= deadline advance1))
                         delivered status1)
                    status1))))
  (= deliveries2
     (+ deliveries1
        (ite (or (and (= op1 register)
                      (= status1 absent)
                      (<= deadline time1))
                 (and (= op1 advance)
                      (= status1 pending)
                      (<= deadline advance1)))
             1 0))))
  :named transition_1))

(assert (! (and
  (<= 0 advance2) (<= advance2 3)
  (=> (= op2 advance) (>= advance2 time2))
  (=> (= op2 register) (= status2 absent))
  (= time3 (ite (= op2 advance) advance2 time2))
  (= status3
     (ite (= op2 register)
          (ite (<= deadline time2) delivered pending)
          (ite (= op2 cancel)
               (ite (= status2 pending) cancelled status2)
               (ite (= op2 advance)
                    (ite (and (= status2 pending)
                              (<= deadline advance2))
                         delivered status2)
                    status2))))
  (= deliveries3
     (+ deliveries2
        (ite (or (and (= op2 register)
                      (= status2 absent)
                      (<= deadline time2))
                 (and (= op2 advance)
                      (= status2 pending)
                      (<= deadline advance2)))
             1 0))))
  :named transition_2))

(assert (! (and
  (<= 0 advance3) (<= advance3 3)
  (=> (= op3 advance) (>= advance3 time3))
  (=> (= op3 register) (= status3 absent))
  (= time4 (ite (= op3 advance) advance3 time3))
  (= status4
     (ite (= op3 register)
          (ite (<= deadline time3) delivered pending)
          (ite (= op3 cancel)
               (ite (= status3 pending) cancelled status3)
               (ite (= op3 advance)
                    (ite (and (= status3 pending)
                              (<= deadline advance3))
                         delivered status3)
                    status3))))
  (= deliveries4
     (+ deliveries3
        (ite (or (and (= op3 register)
                      (= status3 absent)
                      (<= deadline time3))
                 (and (= op3 advance)
                      (= status3 pending)
                      (<= deadline advance3)))
             1 0))))
  :named transition_3))

(declare-const violation Bool)
(assert (! (= violation
  (or
    (> deliveries1 1)
    (and (= status1 delivered) (< time1 deadline))
    (and (= status1 pending) (<= deadline time1))
    (and (= status1 cancelled) (> deliveries1 0))
    (> deliveries2 1)
    (and (= status2 delivered) (< time2 deadline))
    (and (= status2 pending) (<= deadline time2))
    (and (= status2 cancelled) (> deliveries2 0))
    (> deliveries3 1)
    (and (= status3 delivered) (< time3 deadline))
    (and (= status3 pending) (<= deadline time3))
    (and (= status3 cancelled) (> deliveries3 0))
    (> deliveries4 1)
    (and (= status4 delivered) (< time4 deadline))
    (and (= status4 pending) (<= deadline time4))
    (and (= status4 cancelled) (> deliveries4 0))))
  :named violation_definition))

(assert (! violation :named violation_query))
