{:paths ["src" "resources"]

 :deps
 {io.github.casselc/jolt-sim-report
  {:local/root "../report"}

  io.github.casselc/jolt-http
  {:git/url "https://github.com/casselc/jolt-http.git"
   :git/sha "96bd0fc93f1a2c77128d06f74802dd2a4631c0d4"}

  ;; Override jolt-http's older transitive transport pins with the same
  ;; Jolt-0.5.20-compatible pair exercised by the canonical application
  ;; aliases in the repository root. The older jolt-tcp coordinate calls the
  ;; removed jolt.host/monotonic-nanos var; this pin uses jolt.host/mono-nanos.
  io.github.casselc/jolt-tcp
  {:git/url "https://github.com/casselc/jolt-tcp.git"
   :git/sha "0ceaa900bfca11933d35831d7697c7e2c5b22f04"}

  io.github.casselc/jolt-net
  {:git/url "https://github.com/casselc/jolt-net.git"
   :git/sha "699b908ffb4eb79ad35055cdc20866bb504e6932"}}

 :aliases
 {:test
  {:extra-paths ["test"]
   :main-opts ["-m" "jolt.sim.viewer-test"]}

  :viewer
  {:main-opts ["-m" "jolt.sim.viewer"]}}}
