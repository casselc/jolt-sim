; Agreement with protobuf's own parser. Needs python3 with protobuf:
;   dune build @import/test/agreement
(executable
 (name agreement)
 (modules agreement)
 (libraries cordis_import cordis_graph cordis_cel cel_testgen hegel alcotest unix yojson))

(rule
 (alias agreement)
 (deps protos/corpus.binpb pbcheck.py)
 (action
  (run %{exe:agreement.exe} protos/corpus.binpb pbcheck.py)))

; The codec, by example
(test
 (name codec_test)
 (modules codec_test)
 (libraries cordis_import cordis_cel alcotest)
 (deps protos/corpus.binpb)
 (action
  (run %{test} protos/corpus.binpb)))

; Golden files: the corpus's import, as checked in
(rule
 (with-stdout-to types.cg.out (run %{exe:../bin/cimport.exe} protobuf %{dep:protos/corpus.binpb} --print types)))
(rule
 (with-stdout-to report.txt.out (run %{exe:../bin/cimport.exe} protobuf %{dep:protos/corpus.binpb} --print report)))
(rule
 (with-stdout-to names.json.out (run %{exe:../bin/cimport.exe} protobuf %{dep:protos/corpus.binpb} --print names)))
(rule (alias runtest) (action (diff golden/types.cg types.cg.out)))
(rule (alias runtest) (action (diff golden/report.txt report.txt.out)))
(rule (alias runtest) (action (diff golden/names.json names.json.out)))

; The validation predicate against the official JSON Schema Test Suite;
; the skipped schemas, by reason, are checked in
(executable
 (name schema_suite)
 (modules schema_suite)
 (libraries cordis_import cordis_graph cordis_cel yojson))

(rule
 (deps (source_tree json-schema-test-suite))
 (action
  (with-stdout-to schema_suite.out
   (run %{exe:schema_suite.exe} json-schema-test-suite))))

(rule (alias runtest) (action (diff golden/schema_suite.txt schema_suite.out)))

; Values of imported types, shared by the agreement tests
(library
 (name typed_values)
 (wrapped false)
 (modules typed_values)
 (libraries cordis_import cordis_cel cel_testgen yojson))

; The JSON Schema importer against Python's jsonschema. Needs python3 with
; jsonschema:
;   dune build @import/test/schema-agreement
(executable
 (name schema_agreement)
 (modules schema_agreement)
 (libraries typed_values cordis_import cordis_graph cordis_cel cel_testgen hegel alcotest unix yojson))

(rule
 (alias schema-agreement)
 (deps jsvalid.py (glob_files schemas/*.json))
 (action
  (run %{exe:schema_agreement.exe} jsvalid.py schemas/shop.schema.json schemas/events.schema.json schemas/tree.schema.json)))
(rule (with-stdout-to shop.types.out (run %{exe:../bin/cimport.exe} jsonschema %{dep:schemas/shop.schema.json} --print types)))
(rule (alias runtest) (action (diff golden/shop.types.txt shop.types.out)))
(rule (with-stdout-to shop.report.out (run %{exe:../bin/cimport.exe} jsonschema %{dep:schemas/shop.schema.json} --print report)))
(rule (alias runtest) (action (diff golden/shop.report.txt shop.report.out)))
(rule (with-stdout-to shop.names.out (run %{exe:../bin/cimport.exe} jsonschema %{dep:schemas/shop.schema.json} --print names)))
(rule (alias runtest) (action (diff golden/shop.names.txt shop.names.out)))
(rule (with-stdout-to events.types.out (run %{exe:../bin/cimport.exe} jsonschema %{dep:schemas/events.schema.json} --print types)))
(rule (alias runtest) (action (diff golden/events.types.txt events.types.out)))
(rule (with-stdout-to events.report.out (run %{exe:../bin/cimport.exe} jsonschema %{dep:schemas/events.schema.json} --print report)))
(rule (alias runtest) (action (diff golden/events.report.txt events.report.out)))
(rule (with-stdout-to events.names.out (run %{exe:../bin/cimport.exe} jsonschema %{dep:schemas/events.schema.json} --print names)))
(rule (alias runtest) (action (diff golden/events.names.txt events.names.out)))
(rule (with-stdout-to tree.types.out (run %{exe:../bin/cimport.exe} jsonschema %{dep:schemas/tree.schema.json} --print types)))
(rule (alias runtest) (action (diff golden/tree.types.txt tree.types.out)))
(rule (with-stdout-to tree.report.out (run %{exe:../bin/cimport.exe} jsonschema %{dep:schemas/tree.schema.json} --print report)))
(rule (alias runtest) (action (diff golden/tree.report.txt tree.report.out)))
(rule (with-stdout-to tree.names.out (run %{exe:../bin/cimport.exe} jsonschema %{dep:schemas/tree.schema.json} --print names)))
(rule (alias runtest) (action (diff golden/tree.names.txt tree.names.out)))

; The importer over SchemaStore, at a pinned commit (fetch_schemastore.sh
; DIR fetches it, about 100 MB). Needs python3 with jsonschema:
;   SCHEMASTORE=DIR dune build @import/test/schemastore
(executable
 (name schemastore)
 (modules schemastore)
 (libraries cordis_import cordis_graph cordis_cel unix yojson))

(rule
 (alias schemastore)
 (deps jsvalid.py golden/schemastore.txt (source_tree metaschemas))
 (action
  (run %{exe:schemastore.exe} %{env:SCHEMASTORE=schemastore} jsvalid.py --expect golden/schemastore.txt)))

; The OpenAPI importer over a sample of the APIs.guru directory, at a
; pinned commit (fetch_openapi_corpus.sh DIR fetches it, about 90 MB):
;   OPENAPI_CORPUS=DIR dune build @import/test/openapi_corpus
(executable
 (name openapi_corpus)
 (modules openapi_corpus)
 (libraries cordis_import cordis_graph yojson))

(rule
 (alias openapi_corpus)
 (deps golden/openapi_corpus.list golden/openapi_corpus.txt)
 (action
  (run %{exe:openapi_corpus.exe} %{env:OPENAPI_CORPUS=openapi-directory} golden/openapi_corpus.list --expect golden/openapi_corpus.txt)))

; The OpenAPI importer and its wire encoding against openapi-core. Needs
; python3 with openapi-core and PyYAML:
;   dune build @import/test/openapi-agreement
(executable
 (name openapi_agreement)
 (modules openapi_agreement)
 (libraries typed_values cordis_import cordis_cel cel_testgen hegel alcotest unix yojson))

(rule
 (alias openapi-agreement)
 (deps oasvalid.py (glob_files openapi/*.yaml))
 (action
  (run %{exe:openapi_agreement.exe} oasvalid.py openapi/petstore-expanded.yaml openapi/styles.yaml openapi/bodies.yaml)))

; Golden files: the OpenAPI importer's output for the agreement documents
(rule (with-stdout-to openapi-petstore-expanded.types.out (run %{exe:../bin/cimport.exe} openapi %{dep:openapi/petstore-expanded.yaml} --print types)))
(rule (alias runtest) (action (diff golden/openapi-petstore-expanded.types.txt openapi-petstore-expanded.types.out)))
(rule (with-stdout-to openapi-petstore-expanded.report.out (run %{exe:../bin/cimport.exe} openapi %{dep:openapi/petstore-expanded.yaml} --print report)))
(rule (alias runtest) (action (diff golden/openapi-petstore-expanded.report.txt openapi-petstore-expanded.report.out)))
(rule (with-stdout-to openapi-petstore-expanded.names.out (run %{exe:../bin/cimport.exe} openapi %{dep:openapi/petstore-expanded.yaml} --print names)))
(rule (alias runtest) (action (diff golden/openapi-petstore-expanded.names.txt openapi-petstore-expanded.names.out)))
(rule (with-stdout-to openapi-petstore-expanded.operations.out (run %{exe:../bin/cimport.exe} openapi %{dep:openapi/petstore-expanded.yaml} --print operations)))
(rule (alias runtest) (action (diff golden/openapi-petstore-expanded.operations.txt openapi-petstore-expanded.operations.out)))
(rule (with-stdout-to openapi-styles.types.out (run %{exe:../bin/cimport.exe} openapi %{dep:openapi/styles.yaml} --print types)))
(rule (alias runtest) (action (diff golden/openapi-styles.types.txt openapi-styles.types.out)))
(rule (with-stdout-to openapi-styles.report.out (run %{exe:../bin/cimport.exe} openapi %{dep:openapi/styles.yaml} --print report)))
(rule (alias runtest) (action (diff golden/openapi-styles.report.txt openapi-styles.report.out)))
(rule (with-stdout-to openapi-styles.names.out (run %{exe:../bin/cimport.exe} openapi %{dep:openapi/styles.yaml} --print names)))
(rule (alias runtest) (action (diff golden/openapi-styles.names.txt openapi-styles.names.out)))
(rule (with-stdout-to openapi-styles.operations.out (run %{exe:../bin/cimport.exe} openapi %{dep:openapi/styles.yaml} --print operations)))
(rule (alias runtest) (action (diff golden/openapi-styles.operations.txt openapi-styles.operations.out)))
(rule (with-stdout-to openapi-bodies.types.out (run %{exe:../bin/cimport.exe} openapi %{dep:openapi/bodies.yaml} --print types)))
(rule (alias runtest) (action (diff golden/openapi-bodies.types.txt openapi-bodies.types.out)))
(rule (with-stdout-to openapi-bodies.report.out (run %{exe:../bin/cimport.exe} openapi %{dep:openapi/bodies.yaml} --print report)))
(rule (alias runtest) (action (diff golden/openapi-bodies.report.txt openapi-bodies.report.out)))
(rule (with-stdout-to openapi-bodies.names.out (run %{exe:../bin/cimport.exe} openapi %{dep:openapi/bodies.yaml} --print names)))
(rule (alias runtest) (action (diff golden/openapi-bodies.names.txt openapi-bodies.names.out)))
(rule (with-stdout-to openapi-bodies.operations.out (run %{exe:../bin/cimport.exe} openapi %{dep:openapi/bodies.yaml} --print operations)))
(rule (alias runtest) (action (diff golden/openapi-bodies.operations.txt openapi-bodies.operations.out)))
