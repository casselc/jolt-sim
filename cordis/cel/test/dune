; The type-directed expression generator, shared by props and differential
(library
 (name cel_testgen)
 (wrapped false)
 (modules typed_gen)
 (libraries cordis_cel yojson hegel))

(executables
 (names conformance differential)
 (modules conformance differential conformance_values base64_decode)
 (libraries cordis_cel cel_testgen yojson hegel unix re))

; Hegel properties: the checker's algebra and soundness, syntax, values,
; time and protobuf messages
(test
 (name props)
 (modules props)
 (libraries cordis_cel cel_testgen yojson hegel alcotest)
 (deps %{project_root}/cel/conformance/descriptors.json)
 (action
  (run %{test} %{project_root}/cel/conformance/descriptors.json)))

(rule
 (alias runtest)
 (deps
  %{project_root}/cel/conformance/descriptors.json
  (glob_files %{project_root}/cel/conformance/simple/*.json))
 (action
  (run %{exe:conformance.exe} %{project_root}/cel/conformance/simple --fail-on-fail)))

; The same suite, with the protos read from a binary FileDescriptorSet into
; a registry (RFC 0004) instead of the JSON export
(rule
 (alias runtest)
 (deps
  %{project_root}/cel/conformance/descriptors.binpb
  (glob_files %{project_root}/cel/conformance/simple/*.json))
 (action
  (run %{exe:conformance.exe} %{project_root}/cel/conformance/simple --descriptor-set
   %{project_root}/cel/conformance/descriptors.binpb --fail-on-fail)))

; The differential test needs the cel-go reference evaluator (cel/celgo):
;   CELGO=/path/to/celgo dune build @cel/test/differential
(rule
 (alias differential)
 (action
  (run %{exe:differential.exe} %{env:CELGO=celgo} --cases %{env:CEL_DIFF_CASES=2000})))

; The harness extensions: fold, match, function libraries
(test
 (name extensions_test)
 (modules extensions_test)
 (libraries cordis_cel alcotest))

; Registries as values: isolation, also across domains; conflicts
(test
 (name registry_test)
 (modules registry_test)
 (libraries cordis_cel hegel alcotest))
