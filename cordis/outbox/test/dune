; The review loop as processes: cordis-run and cordis-outbox over a socket,
; against a stand-in completions server, with the runner killed twice
;   dune build @outbox/test/e2e
(rule
 (alias e2e)
 (deps e2e.sh stub_llm.py %{bin:cordis-run} %{bin:cordis-outbox} ../../graph/examples/review.cg)
 (action
  (run bash %{dep:e2e.sh} %{bin:cordis-run} %{bin:cordis-outbox} %{dep:../../graph/examples/review.cg} %{dep:stub_llm.py})))

; The central limiter shared by two agents (outbox.qnt's withinLimit)
(rule
 (alias e2e)
 (deps limiter.sh stub_llm.py %{bin:cordis-run} %{bin:cordis-outbox} %{bin:cordis-limiter} ../../graph/examples/review.cg)
 (action
  (run bash %{dep:limiter.sh} %{bin:cordis-run} %{bin:cordis-outbox} %{bin:cordis-limiter} %{dep:../../graph/examples/review.cg} %{dep:stub_llm.py})))

; Admission across processes: soak, refusals, a crash mid-cutover, the audit after
(rule
 (alias e2e)
 (deps cutover.sh stub_llm.py %{bin:cordis-run} %{bin:cordis-outbox} ../../graph/examples/review.cg)
 (action
  (run bash %{dep:cutover.sh} %{bin:cordis-run} %{bin:cordis-outbox} %{dep:../../graph/examples/review.cg} %{dep:stub_llm.py})))

; An imported API end to end: the http executor against a stand-in Notes
; server, a keyed create resent after a dropped answer and applied once
(rule
 (alias e2e)
 (deps openapi.sh stub_notes.py notes.yaml notes_graph.cg %{bin:cordis-run} %{bin:cordis-outbox} ../../import/bin/cimport.exe)
 (action
  (run bash %{dep:openapi.sh} %{bin:cordis-run} %{bin:cordis-outbox} %{dep:../../import/bin/cimport.exe} %{dep:notes.yaml} %{dep:notes_graph.cg} %{dep:stub_notes.py})))

; The review loop against a stand-in with a real model's habits: slow calls,
; long multi-line answers, cut-off answers, no usage, a refusal
(rule
 (alias e2e)
 (deps latency.sh stub_llm.py %{bin:cordis-run} %{bin:cordis-outbox} ../../graph/examples/review.cg)
 (action
  (run bash %{dep:latency.sh} %{bin:cordis-run} %{bin:cordis-outbox} %{dep:../../graph/examples/review.cg} %{dep:stub_llm.py})))

; The review loop with a writer that applies the notes (review_fix.cg)
(rule
 (alias e2e)
 (deps fix.sh stub_llm.py %{bin:cordis-run} %{bin:cordis-outbox} ../../graph/examples/review_fix.cg)
 (action
  (run bash %{dep:fix.sh} %{bin:cordis-run} %{bin:cordis-outbox} %{dep:../../graph/examples/review_fix.cg} %{dep:stub_llm.py})))

; Several agents at once against one server: contention, a 429 waited out,
; exactly-once per agent (fanout.sh also drives a real server for a halo run)
(rule
 (alias e2e)
 (deps fanout.sh stub_llm.py %{bin:cordis-run} %{bin:cordis-outbox} ../../graph/examples/review.cg)
 (action
  (run bash %{dep:fanout.sh} %{bin:cordis-run} %{bin:cordis-outbox} %{dep:../../graph/examples/review.cg} review_loop stub:busy-first=1 4)))

; The stand-in for halo-flash's operation API (RFC 0007) against its own contract: every status answer and fault
(rule
 (alias e2e)
 (deps stub_ops.py stub_ops_selftest.py)
 (action
  (run python3 %{dep:stub_ops_selftest.py})))
