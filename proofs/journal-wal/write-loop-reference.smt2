(set-option :produce-unsat-cores true)
(set-logic QF_LIA)

(declare-const total Int)
(declare-const accepted0 Int)
(declare-const r0 Int)
(declare-const r1 Int)
(declare-const r2 Int)
(declare-const eintr0 Bool)
(declare-const eintr1 Bool)
(declare-const eintr2 Bool)
(declare-const p0 Int)
(declare-const p1 Int)
(declare-const p2 Int)
(declare-const p3 Int)
(declare-const active0 Bool)
(declare-const active1 Bool)
(declare-const active2 Bool)
(declare-const accepted1 Int)
(declare-const complete Bool)
(declare-const violation Bool)

(assert (! (and (<= 1 total) (<= total 8)) :named total-domain))
(assert (! (= p0 0) :named initial-position))
(assert (! (= active0 (< p0 total)) :named active0-def))
(assert (! (and (<= 0 r0) (<= r0 (- total p0)))
           :named result0-domain))
(assert (! (=> (or (not active0) eintr0) (= r0 0))
           :named result0-disabled))
(assert (! (= p1
              (ite active0 (ite eintr0 p0 (+ p0 r0)) p0))
           :named position1-transition))

(assert (! (= active1 (< p1 total)) :named active1-def))
(assert (! (and (<= 0 r1) (<= r1 (- total p1)))
           :named result1-domain))
(assert (! (=> (or (not active1) eintr1) (= r1 0))
           :named result1-disabled))
(assert (! (= p2
              (ite active1 (ite eintr1 p1 (+ p1 r1)) p1))
           :named position2-transition))

(assert (! (= active2 (< p2 total)) :named active2-def))
(assert (! (and (<= 0 r2) (<= r2 (- total p2)))
           :named result2-domain))
(assert (! (=> (or (not active2) eintr2) (= r2 0))
           :named result2-disabled))
(assert (! (= p3
              (ite active2 (ite eintr2 p2 (+ p2 r2)) p2))
           :named position3-transition))

(assert (! (= complete (= p3 total)) :named complete-def))
(assert (! (= accepted1
              (ite complete (+ accepted0 total) accepted0))
           :named accepted-transition))
(assert (! (= violation
              (or (< p1 p0) (< p2 p1) (< p3 p2)
                  (> p1 total) (> p2 total) (> p3 total)
                  (and (not complete) (not (= accepted1 accepted0)))
                  (and complete
                       (not (= accepted1 (+ accepted0 total))))
                  (and eintr0 (not (= p1 p0)))
                  (and eintr1 (not (= p2 p1)))
                  (and eintr2 (not (= p3 p2)))))
           :named violation-def))
(assert (! violation :named query))
(check-sat)
(get-unsat-core)
