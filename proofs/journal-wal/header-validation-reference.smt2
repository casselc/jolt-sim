(set-option :produce-unsat-cores true)
(set-logic QF_LIA)

(declare-const header-complete Bool)
(declare-const magic-valid Bool)
(declare-const version-valid Bool)
(declare-const length-valid Bool)
(declare-const crc-valid Bool)
(declare-const header-valid Bool)
(declare-const record-complete Bool)
(declare-const record-crc-valid Bool)
(declare-const phase0 Int)
(declare-const phase1 Int)
(declare-const cursor0 Int)
(declare-const cursor1 Int)
(declare-const count0 Int)
(declare-const count1 Int)
(declare-const take-record Bool)
(declare-const violation Bool)

(assert (! (= header-valid
              (and header-complete magic-valid version-valid
                   length-valid crc-valid))
           :named header-valid-def))
(assert (! (= phase0 0) :named initial-phase))
(assert (! (= cursor0 0) :named initial-cursor))
(assert (! (= count0 0) :named initial-count))
(assert (! (= phase1 (ite header-valid 1 (- 1)))
           :named header-transition))
(assert (! (= cursor1 (ite header-valid 36 cursor0))
           :named header-cursor-transition))
(assert (! (= take-record
              (and (= phase1 1) record-complete record-crc-valid))
           :named record-transition))
(assert (! (= count1 (ite take-record 1 count0))
           :named record-count-transition))
(assert (! (= violation
              (or (and (not header-valid)
                       (or (> cursor1 0) (> count1 0)))
                  (and header-valid (not (= cursor1 36)))
                  (and (> count1 0) (not header-valid))))
           :named violation-def))
(assert (! violation :named query))
(check-sat)
(get-unsat-core)
