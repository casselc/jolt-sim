(set-option :produce-unsat-cores true)
(set-logic QF_LIA)

; Status encoding: 0 = active, 1 = complete, 2 = failed.
; An active outcome of zero is EINTR.  A positive outcome is byte progress.
; An inactive outcome is -1, meaning that no further write was attempted.
(declare-const total Int)
(declare-const max-eintr-retries Int)
(declare-const accepted0 Int)

(declare-const outcome0 Int)
(declare-const outcome1 Int)
(declare-const outcome2 Int)
(declare-const outcome3 Int)
(declare-const outcome4 Int)

(declare-const status0 Int)
(declare-const status1 Int)
(declare-const status2 Int)
(declare-const status3 Int)
(declare-const status4 Int)
(declare-const status5 Int)

(declare-const position0 Int)
(declare-const position1 Int)
(declare-const position2 Int)
(declare-const position3 Int)
(declare-const position4 Int)
(declare-const position5 Int)

(declare-const retries0 Int)
(declare-const retries1 Int)
(declare-const retries2 Int)
(declare-const retries3 Int)
(declare-const retries4 Int)
(declare-const retries5 Int)

(declare-const accepted1 Int)
(declare-const accepted2 Int)
(declare-const accepted3 Int)
(declare-const accepted4 Int)
(declare-const accepted5 Int)

(declare-const all-eintr-until-terminal Bool)
(declare-const safety Bool)
(declare-const violation Bool)

(assert (! (and (<= 1 total) (<= total 8)) :named total-domain))
(assert (! (and (<= 0 max-eintr-retries)
                (<= max-eintr-retries 3))
           :named retry-bound-domain))
(assert (! (<= 0 accepted0) :named accepted-domain))
(assert (! (= status0 0) :named initial-status))
(assert (! (= position0 0) :named initial-position))
(assert (! (= retries0 0) :named initial-retries))

; Transition 0. At most max-eintr-retries consecutive interruptions are
; tolerated.  The next one records max+1 and enters the absorbing failed state.
(assert (! (ite (= status0 0)
                (and (<= 0 outcome0)
                     (<= outcome0 (- total position0)))
                (= outcome0 (- 1)))
           :named outcome0-domain))
(assert (! (= position1
              (ite (= status0 0)
                   (ite (= outcome0 0)
                        position0
                        (+ position0 outcome0))
                   position0))
           :named position1-transition))
(assert (! (= retries1
              (ite (= status0 0)
                   (ite (= outcome0 0) (+ retries0 1) 0)
                   retries0))
           :named retries1-transition))
(assert (! (= status1
              (ite (= status0 0)
                   (ite (= outcome0 0)
                        (ite (> (+ retries0 1) max-eintr-retries) 2 0)
                        (ite (= (+ position0 outcome0) total) 1 0))
                   status0))
           :named status1-transition))
(assert (! (= accepted1
              (ite (and (= status0 0) (= status1 1))
                   (+ accepted0 total)
                   accepted0))
           :named accepted1-transition))

; Transition 1.
(assert (! (ite (= status1 0)
                (and (<= 0 outcome1)
                     (<= outcome1 (- total position1)))
                (= outcome1 (- 1)))
           :named outcome1-domain))
(assert (! (= position2
              (ite (= status1 0)
                   (ite (= outcome1 0)
                        position1
                        (+ position1 outcome1))
                   position1))
           :named position2-transition))
(assert (! (= retries2
              (ite (= status1 0)
                   (ite (= outcome1 0) (+ retries1 1) 0)
                   retries1))
           :named retries2-transition))
(assert (! (= status2
              (ite (= status1 0)
                   (ite (= outcome1 0)
                        (ite (> (+ retries1 1) max-eintr-retries) 2 0)
                        (ite (= (+ position1 outcome1) total) 1 0))
                   status1))
           :named status2-transition))
(assert (! (= accepted2
              (ite (and (= status1 0) (= status2 1))
                   (+ accepted1 total)
                   accepted1))
           :named accepted2-transition))

; Transition 2.
(assert (! (ite (= status2 0)
                (and (<= 0 outcome2)
                     (<= outcome2 (- total position2)))
                (= outcome2 (- 1)))
           :named outcome2-domain))
(assert (! (= position3
              (ite (= status2 0)
                   (ite (= outcome2 0)
                        position2
                        (+ position2 outcome2))
                   position2))
           :named position3-transition))
(assert (! (= retries3
              (ite (= status2 0)
                   (ite (= outcome2 0) (+ retries2 1) 0)
                   retries2))
           :named retries3-transition))
(assert (! (= status3
              (ite (= status2 0)
                   (ite (= outcome2 0)
                        (ite (> (+ retries2 1) max-eintr-retries) 2 0)
                        (ite (= (+ position2 outcome2) total) 1 0))
                   status2))
           :named status3-transition))
(assert (! (= accepted3
              (ite (and (= status2 0) (= status3 1))
                   (+ accepted2 total)
                   accepted2))
           :named accepted3-transition))

; Transition 3.
(assert (! (ite (= status3 0)
                (and (<= 0 outcome3)
                     (<= outcome3 (- total position3)))
                (= outcome3 (- 1)))
           :named outcome3-domain))
(assert (! (= position4
              (ite (= status3 0)
                   (ite (= outcome3 0)
                        position3
                        (+ position3 outcome3))
                   position3))
           :named position4-transition))
(assert (! (= retries4
              (ite (= status3 0)
                   (ite (= outcome3 0) (+ retries3 1) 0)
                   retries3))
           :named retries4-transition))
(assert (! (= status4
              (ite (= status3 0)
                   (ite (= outcome3 0)
                        (ite (> (+ retries3 1) max-eintr-retries) 2 0)
                        (ite (= (+ position3 outcome3) total) 1 0))
                   status3))
           :named status4-transition))
(assert (! (= accepted4
              (ite (and (= status3 0) (= status4 1))
                   (+ accepted3 total)
                   accepted3))
           :named accepted4-transition))

; Transition 4. Five transitions cover max values zero through three and leave
; one absorbing-state observation after the latest possible failure.
(assert (! (ite (= status4 0)
                (and (<= 0 outcome4)
                     (<= outcome4 (- total position4)))
                (= outcome4 (- 1)))
           :named outcome4-domain))
(assert (! (= position5
              (ite (= status4 0)
                   (ite (= outcome4 0)
                        position4
                        (+ position4 outcome4))
                   position4))
           :named position5-transition))
(assert (! (= retries5
              (ite (= status4 0)
                   (ite (= outcome4 0) (+ retries4 1) 0)
                   retries4))
           :named retries5-transition))
(assert (! (= status5
              (ite (= status4 0)
                   (ite (= outcome4 0)
                        (ite (> (+ retries4 1) max-eintr-retries) 2 0)
                        (ite (= (+ position4 outcome4) total) 1 0))
                   status4))
           :named status5-transition))
(assert (! (= accepted5
              (ite (and (= status4 0) (= status5 1))
                   (+ accepted4 total)
                   accepted4))
           :named accepted5-transition))

(assert (! (= all-eintr-until-terminal
              (and (=> (= status0 0) (= outcome0 0))
                   (=> (= status1 0) (= outcome1 0))
                   (=> (= status2 0) (= outcome2 0))
                   (=> (= status3 0) (= outcome3 0))
                   (=> (= status4 0) (= outcome4 0))))
           :named all-eintr-definition))

; Safety is stated separately from the transition relation.  In particular,
; accepted-end may change only on an active-to-complete transition whose new
; position is the full frame length.  The all-EINTR trace must terminate failed
; within the finite bound and must leave both position and accepted-end alone.
(assert (! (= safety
              (and
                (and (<= 0 position0) (<= position0 total)
                     (<= 0 position1) (<= position1 total)
                     (<= 0 position2) (<= position2 total)
                     (<= 0 position3) (<= position3 total)
                     (<= 0 position4) (<= position4 total)
                     (<= 0 position5) (<= position5 total))
                (<= position0 position1)
                (<= position1 position2)
                (<= position2 position3)
                (<= position3 position4)
                (<= position4 position5)
                (=> (and (= status0 0) (= outcome0 0))
                    (and (= position1 position0)
                         (= retries1 (+ retries0 1))))
                (=> (and (= status1 0) (= outcome1 0))
                    (and (= position2 position1)
                         (= retries2 (+ retries1 1))))
                (=> (and (= status2 0) (= outcome2 0))
                    (and (= position3 position2)
                         (= retries3 (+ retries2 1))))
                (=> (and (= status3 0) (= outcome3 0))
                    (and (= position4 position3)
                         (= retries4 (+ retries3 1))))
                (=> (and (= status4 0) (= outcome4 0))
                    (and (= position5 position4)
                         (= retries5 (+ retries4 1))))
                (=> (and (= status0 0) (> outcome0 0)) (= retries1 0))
                (=> (and (= status1 0) (> outcome1 0)) (= retries2 0))
                (=> (and (= status2 0) (> outcome2 0)) (= retries3 0))
                (=> (and (= status3 0) (> outcome3 0)) (= retries4 0))
                (=> (and (= status4 0) (> outcome4 0)) (= retries5 0))
                (=> (and (= status0 0)
                         (= outcome0 0)
                         (> (+ retries0 1) max-eintr-retries))
                    (= status1 2))
                (=> (and (= status1 0)
                         (= outcome1 0)
                         (> (+ retries1 1) max-eintr-retries))
                    (= status2 2))
                (=> (and (= status2 0)
                         (= outcome2 0)
                         (> (+ retries2 1) max-eintr-retries))
                    (= status3 2))
                (=> (and (= status3 0)
                         (= outcome3 0)
                         (> (+ retries3 1) max-eintr-retries))
                    (= status4 2))
                (=> (and (= status4 0)
                         (= outcome4 0)
                         (> (+ retries4 1) max-eintr-retries))
                    (= status5 2))
                (=> (not (and (= status0 0) (= status1 1)))
                    (= accepted1 accepted0))
                (=> (not (and (= status1 0) (= status2 1)))
                    (= accepted2 accepted1))
                (=> (not (and (= status2 0) (= status3 1)))
                    (= accepted3 accepted2))
                (=> (not (and (= status3 0) (= status4 1)))
                    (= accepted4 accepted3))
                (=> (not (and (= status4 0) (= status5 1)))
                    (= accepted5 accepted4))
                (=> (and (= status0 0) (= status1 1))
                    (and (= position1 total)
                         (= accepted1 (+ accepted0 total))))
                (=> (and (= status1 0) (= status2 1))
                    (and (= position2 total)
                         (= accepted2 (+ accepted1 total))))
                (=> (and (= status2 0) (= status3 1))
                    (and (= position3 total)
                         (= accepted3 (+ accepted2 total))))
                (=> (and (= status3 0) (= status4 1))
                    (and (= position4 total)
                         (= accepted4 (+ accepted3 total))))
                (=> (and (= status4 0) (= status5 1))
                    (and (= position5 total)
                         (= accepted5 (+ accepted4 total))))
                (=> all-eintr-until-terminal
                    (and (= status5 2)
                         (= position5 0)
                         (= accepted5 accepted0)))))
           :named safety-definition))
(assert (! (= violation (not safety)) :named violation-definition))
(assert (! violation :named query))
(check-sat)
(get-unsat-core)
