(set-logic QF_LIA)

(declare-const header Int)
(declare-const record-header Int)
(declare-const trailer Int)
(declare-const payload Int)
(declare-const cut Int)
(declare-const actual-end Int)
(declare-const buggy-end Int)
(declare-const buggy-accept Bool)
(declare-const actual-complete Bool)
(declare-const violation Bool)

(assert (= header 36))
(assert (= record-header 24))
(assert (= trailer 4))
(assert (= payload 0))
(assert (= actual-end (+ header record-header payload trailer)))
(assert (= buggy-end (+ header record-header payload)))
(assert (= cut buggy-end))
; Bug: accept header plus payload without the trailing CRC completion marker.
(assert (= buggy-accept (<= buggy-end cut)))
(assert (= actual-complete (<= actual-end cut)))
(assert (= violation (and buggy-accept (not actual-complete))))
(assert violation)
(check-sat)
(get-model)
