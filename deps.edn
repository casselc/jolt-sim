{:paths ["src"]

 :aliases
 {:test {:extra-paths ["test"]
         :main-opts ["-m" "jolt.sim.test-main"]}

  ;; Process-isolated because the asserted failure deliberately retains the
  ;; installed controllers and poisons the single adapter session.
  :runtime-poison-test
  {:extra-paths ["test"]
   :main-opts ["-m" "jolt.sim.runtime-poison-test"]}

  ;; Process-isolated because the scheduler makes no deadlock-recovery claim:
  ;; this deliberately leaves a thread blocked forever and relies on process
  ;; exit, not graceful unwinding, to reclaim it.
  :future-schedule-poison-test
  {:extra-paths ["test"]
   :main-opts ["-m" "jolt.sim.future-schedule-poison-test"]}

  ;; Workspace integration lanes: the canonical db checkout is ../db.
  :sqlite-test
  {:extra-paths ["test"]
   :extra-deps {local/db {:local/root "../db"}}
   :main-opts ["-m" "jolt.sim.sqlite-integration-test"]}

  :sqlite-sim-test
  {:extra-paths ["test" "../db/clj"]
   :main-opts ["-m" "jolt.sim.sqlite-integration-test" "--sim-only"]}}

 :tasks
 {check "jolt -M:test"}}
