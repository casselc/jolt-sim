{:paths ["src"]

 :deps
 {metosin/malli {:mvn/version "0.20.1"}}

 ;; Hegel aliases below may launch a second alias in a fresh child. Run them
 ;; through script/run-hegel-gates.sh so both dependency graphs are prepared
 ;; before generation and infrastructure failures retain one bounded bundle.
 :aliases
 {:test
  {:extra-paths ["test"]
   :extra-deps
   {io.github.casselc/data.json
    {:git/url "https://github.com/casselc/data.json.git"
     :git/sha "8a6dc9668e5c3596a335759defeb7ec80cd3b5f8"}
    io.github.jolt-lang/time
    {:git/url "https://github.com/jolt-lang/time.git"
     :git/sha "da271ca302487c2c5130a0450b4ad4c78d63e656"}}
   :main-opts ["-m" "jolt.sim.test-main"]}

  ;; Real stdin/stdout Maelstrom Echo process. The node and Echo handler are
  ;; the same transport-neutral production namespaces used by simulation.
  :maelstrom-echo
  {:extra-deps
   {io.github.casselc/data.json
    {:git/url "https://github.com/casselc/data.json.git"
     :git/sha "8a6dc9668e5c3596a335759defeb7ec80cd3b5f8"}
    io.github.jolt-lang/time
    {:git/url "https://github.com/jolt-lang/time.git"
     :git/sha "da271ca302487c2c5130a0450b4ad4c78d63e656"}}
   :main-opts ["-m" "jolt.maelstrom.echo-main"]}

  ;; Real stdin/stdout Maelstrom Broadcast process. This entry point composes
  ;; the same transport-neutral application and node namespaces used by the
  ;; simulator, adding only the process-owned periodic retry lifecycle that a
  ;; lossy real network requires.
  :maelstrom-broadcast
  {:extra-deps
   {io.github.casselc/data.json
    {:git/url "https://github.com/casselc/data.json.git"
     :git/sha "8a6dc9668e5c3596a335759defeb7ec80cd3b5f8"}
    io.github.jolt-lang/time
    {:git/url "https://github.com/jolt-lang/time.git"
     :git/sha "da271ca302487c2c5130a0450b4ad4c78d63e656"}}
   :main-opts ["-m" "jolt.maelstrom.broadcast-main"]}

  ;; Converts the official JVM checker's bounded ordinary-EDN staging value
  ;; plus shell-computed logical artifact descriptors into the validated,
  ;; canonical official-run document. It never reads or rewrites raw Maelstrom
  ;; history/result files.
  :maelstrom-official-run-export
  {:main-opts ["-m" "jolt.sim.maelstrom.official-run-export"]}

  ;; Verifier side of script/run-maelstrom-echo-e2e.sh. The shell runner owns
  ;; fresh process launch and retained artifacts; this alias independently
  ;; checks the resulting JSON-lines wire evidence.
  :maelstrom-echo-process-e2e-verify
  {:extra-paths ["test"]
   :extra-deps
   {io.github.casselc/data.json
    {:git/url "https://github.com/casselc/data.json.git"
     :git/sha "8a6dc9668e5c3596a335759defeb7ec80cd3b5f8"}
    io.github.jolt-lang/time
    {:git/url "https://github.com/jolt-lang/time.git"
     :git/sha "da271ca302487c2c5130a0450b4ad4c78d63e656"}}
   :main-opts ["-m" "jolt.maelstrom.json-lines-process-e2e-test"]}

  ;; Focused cooperative-session gate. Keep this independent from the broad
  ;; source suite while the REPL control surface is developed in small slices.
  :session-test
  {:extra-paths ["test"]
   :main-opts ["-m" "jolt.sim.session-test-main"]}

  ;; Focused persistent evaluation-session gate. This uses the socket-free
  ;; evaluator and ordinary source paths; it does not start Ripple or a server.
  :eval-session-test
  {:extra-paths ["test"]
   :main-opts ["-m" "jolt.sim.eval-session-test-main"]}

  ;; Focused parent/child retained-process protocol gate. It uses only local
  ;; source and an in-process worker fixture; the real outbox worker remains a
  ;; separate integration alias because it carries the full ecosystem graph.
  :retained-test
  {:extra-paths ["test"]
   :main-opts ["-m" "jolt.sim.retained-test-main"]}

  ;; UI-neutral retained-process projection and command acknowledgment gate.
  ;; It uses scripted supervisor seams and starts no child process.
  :retained-view-test
  {:extra-paths ["test"]
   :main-opts ["-m" "jolt.sim.retained-view-test"]}

  ;; Main-option overlays for the retained real-outbox vertical. Compose each
  ;; with :outbox-json-delivery-test so parent and child resolve the exact same
  ;; DB/HTTP/TCP/codec dependency graph without duplicating its pins here.
  :retained-outbox-worker
  {:main-opts ["-m" "jolt.sim.retained-worker"]}

  :retained-outbox-test
  {:main-opts ["-m" "jolt.sim.retained-outbox-test-main"]}

  ;; Process-isolated because the asserted failure deliberately retains the
  ;; installed controllers and poisons the single adapter session.
  :runtime-poison-test
  {:extra-paths ["test"]
   :main-opts ["-m" "jolt.sim.runtime-poison-test"]}

  ;; Custom-image integration gate for the descriptor-v8 scoped byte-array
  ;; pointer loan: the loan lifecycle is runtime-owned, only its enclosed
  ;; read/write operations are intercepted, and the deterministic memory
  ;; handlers fail closed on the real loan pointer rather than recreating a
  ;; loan. Kept separate from :test because it requires the sim image.
  :ffi-pointer-loan-test
  {:extra-paths ["test"]
   :main-opts ["-m" "jolt.sim.ffi-pointer-loan-test-main"]}

  ;; Process-isolated because the scheduler makes no deadlock-recovery claim:
  ;; this deliberately leaves a thread blocked forever and relies on process
  ;; exit, not graceful unwinding, to reclaim it.
  :future-schedule-poison-test
  {:extra-paths ["test"]
   :main-opts ["-m" "jolt.sim.future-schedule-poison-test"]}

  ;; One request/result protocol worker per exact future schedule. The parent
  ;; process supplies the request and result paths after these main options.
  ;; The reviewed terminal-wake pin lets a resolved scenario (for example,
  ;; ffi-schedule-scenarios) load unchanged jolt.net code in this child.
  :explore-worker-test
  {:extra-paths ["test"]
   :extra-deps
   {io.github.casselc/jolt-net
    {:git/url "https://github.com/casselc/jolt-net.git"
     :git/sha "699b908ffb4eb79ad35055cdc20866bb504e6932"}}
   :main-opts ["-m" "jolt.sim.explore-worker"]}

  ;; Process-isolated integration gate for worker completion, timeout,
  ;; termination/reaping, and canonical result transport.
  :explore-process-test
  {:extra-paths ["test"]
   :main-opts ["-m" "jolt.sim.explore-process-test"]}

  ;; Optional Hegel generator/shrinker adapter and its fresh-process
  ;; exploration witness. Keep the released dependency out of the ordinary
  ;; compatibility suite and pin the peeled v0.1.2 commit exactly.
  :hegel-explore-test
  {:extra-paths ["test"]
   :extra-deps
   {io.github.chucklehead-dev/jolt-hegel
    {:git/url "https://github.com/chucklehead-dev/jolt-hegel.git"
     :git/sha "ffe523023437862c7e474dc216346426318754c6"}}
   :main-opts ["-m" "jolt.sim.hegel-explore-test"]}

  ;; In-process Hegel property lane over the unchanged Maelstrom Echo
  ;; scenario fixture (jolt.maelstrom.fixtures.echo-scenario/echo-roundtrip):
  ;; bounded immutable JSON-shaped payloads round-trip through the real
  ;; node/echo handlers and memory transport under the sim controller in
  ;; THIS process. There is no nested worker alias to preflight; run through
  ;; script/run-hegel-gates.sh so dependency and Hegel native preflight
  ;; still happen before generation. Pinned to the same peeled v0.1.2
  ;; jolt-hegel commit as :hegel-explore-test.
  :maelstrom-echo-hegel-test
  {:extra-paths ["test"]
   :extra-deps
   {io.github.chucklehead-dev/jolt-hegel
    {:git/url "https://github.com/chucklehead-dev/jolt-hegel.git"
     :git/sha "ffe523023437862c7e474dc216346426318754c6"}}
   :main-opts ["-m" "jolt.maelstrom.echo-hegel-test"]}

  ;; In-process paired-regime property lane over the unchanged three-node
  ;; Broadcast defsim. Every generated signed-64-bit message runs both the
  ;; healthy line topology and the fixed n2--n3 partition/heal input, so the
  ;; fault cannot be omitted or shrunk away. There is no nested worker alias;
  ;; use script/run-hegel-gates.sh for dependency/native preflight and retained
  ;; gate evidence. Pinned to the same peeled v0.1.2 jolt-hegel commit.
  :maelstrom-broadcast-hegel-test
  {:extra-paths ["test"]
   :extra-deps
   {io.github.chucklehead-dev/jolt-hegel
    {:git/url "https://github.com/chucklehead-dev/jolt-hegel.git"
     :git/sha "ffe523023437862c7e474dc216346426318754c6"}}
   :main-opts ["-m" "jolt.maelstrom.broadcast-hegel-test"]}

  ;; Hegel-owned, shrinkable capacities and poll-fault ordinals drive the
  ;; unchanged HTTP + SQLite application in a fresh worker for every case.
  :http-sqlite-hegel-test
  {:extra-paths ["test"]
   :extra-deps
   {io.github.chucklehead-dev/jolt-hegel
    {:git/url "https://github.com/chucklehead-dev/jolt-hegel.git"
     :git/sha "ffe523023437862c7e474dc216346426318754c6"}}
   :main-opts ["-m" "jolt.sim.http-sqlite-hegel-test"]}

  ;; Child side of :http-sqlite-hegel-test. Loading db from source keeps the
  ;; hermetic worker from initializing the real SQLite library before control.
  :http-sqlite-explore-worker
  {:extra-paths ["test"]
   :extra-deps
   {io.github.casselc/db
    {:git/url "https://github.com/casselc/db.git"
     :git/sha "df8f434f7ebf5e63b3f52ab6c5c2a2b2c92d3a6d"
     :deps/root "clj"}
    io.github.casselc/jolt-http
    {:git/url "https://github.com/casselc/jolt-http.git"
     :git/sha "96bd0fc93f1a2c77128d06f74802dd2a4631c0d4"}
    io.github.casselc/jolt-tcp
    {:git/url "https://github.com/casselc/jolt-tcp.git"
     :git/sha "0ceaa900bfca11933d35831d7697c7e2c5b22f04"}
    io.github.casselc/jolt-net
    {:git/url "https://github.com/casselc/jolt-net.git"
     :git/sha "699b908ffb4eb79ad35055cdc20866bb504e6932"}}
   :main-opts ["-m" "jolt.sim.explore-worker"]}

  ;; Real SQLite lane: use the complete public DB coordinate so its native
  ;; library declaration is available to the launcher.
  :sqlite-test
  {:extra-paths ["test"]
   :extra-deps
   {io.github.casselc/db
    {:git/url "https://github.com/casselc/db.git"
     :git/sha "df8f434f7ebf5e63b3f52ab6c5c2a2b2c92d3a6d"}}
   :main-opts ["-m" "jolt.sim.sqlite-integration-test"]}

  :sqlite-sim-test
  {:extra-paths ["test"]
   :extra-deps
   {io.github.casselc/db
    {:git/url "https://github.com/casselc/db.git"
     :git/sha "df8f434f7ebf5e63b3f52ab6c5c2a2b2c92d3a6d"
     :deps/root "clj"}}
   :main-opts ["-m" "jolt.sim.sqlite-integration-test" "--sim-only"]}

  ;; Independent literal wire vectors and every-boundary fragmentation checks
  ;; for the ordinary TCP + bencode fixture.
  :tcp-bencode-framing-test
  {:extra-paths ["test"]
   :extra-deps
   {io.github.casselc/jolt-tcp
    {:git/url "https://github.com/casselc/jolt-tcp.git"
     :git/sha "0ceaa900bfca11933d35831d7697c7e2c5b22f04"}
    io.github.casselc/jolt-net
    {:git/url "https://github.com/casselc/jolt-net.git"
     :git/sha "699b908ffb4eb79ad35055cdc20866bb504e6932"}
    io.github.casselc/jolt-bencode
    {:git/url "https://github.com/casselc/jolt-bencode.git"
     :git/sha "6c68bf2a1dbd7e438923ce38252c2abbdcb1643f"}
    io.github.casselc/jolt-bytes
    {:git/url "https://github.com/casselc/jolt-bytes.git"
     :git/sha "9c3280eb49c00d0373e32ee6cae74f961a254712"}}
   :main-opts ["-m" "jolt.sim.tcp-bencode-framing-test"]}

  ;; Fresh-worker lane for the TCP + bencode length-framed request/reply
  ;; example: unchanged teensyp.server/client/buffer, jolt.bytes, and
  ;; jolt.bencode application code resolved from jolt.sim.explore-worker.
  ;; jolt-bytes is pinned directly (rather than left to jolt-bencode's own
  ;; transitive pin) so this exact commit wins by dependency depth. The
  ;; scenario imports jolt.net directly for target facts, so its reviewed
  ;; ecosystem commit is direct rather than an accidental transitive detail.
  :tcp-bencode-explore-worker
  {:extra-paths ["test"]
   :extra-deps
   {io.github.casselc/jolt-tcp
    {:git/url "https://github.com/casselc/jolt-tcp.git"
     :git/sha "0ceaa900bfca11933d35831d7697c7e2c5b22f04"}
    io.github.casselc/jolt-net
    {:git/url "https://github.com/casselc/jolt-net.git"
     :git/sha "699b908ffb4eb79ad35055cdc20866bb504e6932"}
    io.github.casselc/jolt-bencode
    {:git/url "https://github.com/casselc/jolt-bencode.git"
     :git/sha "6c68bf2a1dbd7e438923ce38252c2abbdcb1643f"}
    io.github.casselc/jolt-bytes
    {:git/url "https://github.com/casselc/jolt-bytes.git"
     :git/sha "9c3280eb49c00d0373e32ee6cae74f961a254712"}}
   :main-opts ["-m" "jolt.sim.explore-worker"]}

  ;; Hegel-owned, shrinkable capacities, poll-fault ordinal, and request-text
  ;; domain drive the unchanged TCP + bencode application in a fresh worker
  ;; for every case. This parent alias intentionally carries no teensyp/
  ;; bencode/bytes dependency; only :tcp-bencode-explore-worker resolves the
  ;; scenario namespace, in a fresh child process per case.
  :tcp-bencode-hegel-test
  {:extra-paths ["test"]
   :extra-deps
   {io.github.chucklehead-dev/jolt-hegel
    {:git/url "https://github.com/chucklehead-dev/jolt-hegel.git"
     :git/sha "ffe523023437862c7e474dc216346426318754c6"}}
   :main-opts ["-m" "jolt.sim.tcp-bencode-hegel-test"]}

  ;; Unchanged public jolt.net application code over the deterministic POSIX
  ;; loopback FFI pack. Pin the reviewed terminal-wake correction so public CI
  ;; never depends on a sibling checkout or a moving branch.
  :posix-loopback-test
  {:extra-paths ["test"]
   :extra-deps
   {io.github.casselc/jolt-net
    {:git/url "https://github.com/casselc/jolt-net.git"
     :git/sha "699b908ffb4eb79ad35055cdc20866bb504e6932"}}
   :main-opts ["-m" "jolt.sim.posix-loopback-test-main"]}

  ;; Unchanged public jolt-http (README Hello World) application code over the
  ;; deterministic POSIX loopback FFI pack. Override jolt-http's historical
  ;; transport pins with the reviewed Jolt 0.5.20 clock-compatible jolt-tcp and
  ;; jolt-net commits, so CI needs no sibling checkout or moving branch.
  :http-hello-test
  {:extra-paths ["test"]
   :extra-deps
   {io.github.casselc/jolt-http
    {:git/url "https://github.com/casselc/jolt-http.git"
     :git/sha "96bd0fc93f1a2c77128d06f74802dd2a4631c0d4"}
    io.github.casselc/jolt-tcp
    {:git/url "https://github.com/casselc/jolt-tcp.git"
     :git/sha "0ceaa900bfca11933d35831d7697c7e2c5b22f04"}
    io.github.casselc/jolt-net
    {:git/url "https://github.com/casselc/jolt-net.git"
     :git/sha "699b908ffb4eb79ad35055cdc20866bb504e6932"}}
   :main-opts ["-m" "jolt.sim.posix-loopback-http-test-main"]}

  ;; Ordinary jolt-http and db application code exercised first against real
  ;; sockets/SQLite, then unchanged over one shared simulated native boundary.
  ;; The db checkout is local until the reviewed fork commits are published.
  :http-sqlite-test
  {:extra-paths ["test"]
   :extra-deps
   {io.github.casselc/db
    {:git/url "https://github.com/casselc/db.git"
     :git/sha "df8f434f7ebf5e63b3f52ab6c5c2a2b2c92d3a6d"}
    io.github.casselc/jolt-http
    {:git/url "https://github.com/casselc/jolt-http.git"
     :git/sha "96bd0fc93f1a2c77128d06f74802dd2a4631c0d4"}
    io.github.casselc/jolt-tcp
    {:git/url "https://github.com/casselc/jolt-tcp.git"
     :git/sha "0ceaa900bfca11933d35831d7697c7e2c5b22f04"}
    io.github.casselc/jolt-net
    {:git/url "https://github.com/casselc/jolt-net.git"
     :git/sha "699b908ffb4eb79ad35055cdc20866bb504e6932"}}
   :main-opts ["-m" "jolt.sim.http-sqlite-test-main"]}

  ;; Hermetic SQLite variant: load only db's source path so its native-library
  ;; metadata cannot initialize the real SQLite library before control begins.
  :http-sqlite-sim-test
  {:extra-paths ["test"]
   :extra-deps
   {io.github.casselc/db
    {:git/url "https://github.com/casselc/db.git"
     :git/sha "df8f434f7ebf5e63b3f52ab6c5c2a2b2c92d3a6d"
     :deps/root "clj"}
    io.github.casselc/jolt-http
    {:git/url "https://github.com/casselc/jolt-http.git"
     :git/sha "96bd0fc93f1a2c77128d06f74802dd2a4631c0d4"}
    io.github.casselc/jolt-tcp
    {:git/url "https://github.com/casselc/jolt-tcp.git"
     :git/sha "0ceaa900bfca11933d35831d7697c7e2c5b22f04"}
    io.github.casselc/jolt-net
    {:git/url "https://github.com/casselc/jolt-net.git"
     :git/sha "699b908ffb4eb79ad35055cdc20866bb504e6932"}}
   :main-opts ["-m" "jolt.sim.http-sqlite-test-main" "--sim-only"]}

  ;; Simulator-free pure application core: the canonical HTTP command ->
  ;; SQLite transaction -> TCP bencode delivery slice in jolt.example.outbox.
  ;; No external dependencies and no sim image required.
  :application-core-test
  {:extra-paths ["test"]
   :main-opts ["-m" "jolt.example.outbox-test-main"]}

  ;; Simulator-free transactional outbox adapter gate: the pure
  ;; jolt.example.outbox core over real system SQLite through public jdbc.core,
  ;; proving atomic outer-COMMIT visibility, exact replay, and guarded durable
  ;; delivery marking. Uses the complete public DB coordinate
  ;; so its native library declaration is available to the launcher.
  ;; Sequential, single-owner, fresh in-memory database per test; no sim image
  ;; required.
  :outbox-sqlite-test
  {:extra-paths ["test"]
   :extra-deps
   {io.github.casselc/db
    {:git/url "https://github.com/casselc/db.git"
     :git/sha "df8f434f7ebf5e63b3f52ab6c5c2a2b2c92d3a6d"}}
   :main-opts ["-m" "jolt.example.outbox-sqlite-test-main"]}

  ;; Simulator-free JSON HTTP facade gate: the ordinary
  ;; jolt.example.outbox.http-json facade -- public jolt-http handler
  ;; contract, clojure.data.json at the reviewed public fork commit, and the
  ;; current public Reitit router shim with its own manifest's reitit-core
  ;; and meta-merge pins. data.json loads DateTimeFormatter support when its
  ;; namespace initializes, so the current upstream time provider is direct
  ;; rather than an accidental test-only dependency. The facade drives the
  ;; existing real SQLite outbox
  ;; transaction path. Handler-level: fabricated request maps through the
  ;; public jolt.http.body/RequestBody protocol, no sockets. Uses the
  ;; complete public DB coordinate so its native library declaration is
  ;; available to the launcher. Sequential, single-owner, fresh in-memory
  ;; database per test; no sim image required.
  :outbox-http-json-test
  {:extra-paths ["test"]
   :extra-deps
   {io.github.casselc/db
    {:git/url "https://github.com/casselc/db.git"
     :git/sha "df8f434f7ebf5e63b3f52ab6c5c2a2b2c92d3a6d"}
    io.github.casselc/jolt-http
    {:git/url "https://github.com/casselc/jolt-http.git"
     :git/sha "96bd0fc93f1a2c77128d06f74802dd2a4631c0d4"}
    io.github.casselc/jolt-tcp
    {:git/url "https://github.com/casselc/jolt-tcp.git"
     :git/sha "0ceaa900bfca11933d35831d7697c7e2c5b22f04"}
    io.github.casselc/jolt-net
    {:git/url "https://github.com/casselc/jolt-net.git"
     :git/sha "699b908ffb4eb79ad35055cdc20866bb504e6932"}
    io.github.casselc/data.json
    {:git/url "https://github.com/casselc/data.json.git"
     :git/sha "8a6dc9668e5c3596a335759defeb7ec80cd3b5f8"}
    io.github.jolt-lang/time
    {:git/url "https://github.com/jolt-lang/time.git"
     :git/sha "da271ca302487c2c5130a0450b4ad4c78d63e656"}
    jolt-lang/router
    {:git/url "https://github.com/jolt-lang/router"
     :git/sha "a66fc944f1b1a43d2dff9b322619159c77809885"}
    metosin/reitit-core
    {:git/url "https://github.com/metosin/reitit"
     :git/sha "5d5c965deb3c7c8d64b8dd636432eaa14f0324ec"
     :deps/root "modules/reitit-core"}
    weavejester/meta-merge
    {:git/url "https://github.com/weavejester/meta-merge"
     :git/sha "c968c38baccd4219fe0ba592d89af37ea8e426bf"}}
   :main-opts ["-m" "jolt.example.outbox-http-json-test-main"]}

  ;; First ordinary JSON-facade whole-application witness: one JSON command
  ;; through the existing jolt.example.outbox.http-json handler behind the
  ;; real and hermetic jolt-http server infrastructure, one post-COMMIT SQLite
  ;; outbox reload, one later framed TCP/bencode delivery with an ack, and the
  ;; ack-gated durable delivery marking plus final reload on the same open
  ;; connection. The DB/HTTP/TCP/net/codec/bytes pins match
  ;; :outbox-delivery-test exactly; the data.json/time/router/reitit pins
  ;; match :outbox-http-json-test exactly.
  :outbox-json-delivery-test
  {:extra-paths ["test"]
   :extra-deps
   {io.github.casselc/db
    {:git/url "https://github.com/casselc/db.git"
     :git/sha "df8f434f7ebf5e63b3f52ab6c5c2a2b2c92d3a6d"}
    io.github.casselc/jolt-http
    {:git/url "https://github.com/casselc/jolt-http.git"
     :git/sha "96bd0fc93f1a2c77128d06f74802dd2a4631c0d4"}
    io.github.casselc/jolt-tcp
    {:git/url "https://github.com/casselc/jolt-tcp.git"
     :git/sha "0ceaa900bfca11933d35831d7697c7e2c5b22f04"}
