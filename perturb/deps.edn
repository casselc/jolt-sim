;; perturb — a namespace set running on the Jolt compiler.
;;
;; Deliberately minimal: perturb declares nothing about its semantics here.
;; See docs/SHAREABLE.md S2 — deps resolution is semantics-neutral and this
;; file is evidence of how little of it perturb needs.
{:paths ["src"]

 :aliases
 {;; The claims demo. Talks to a real jolt nREPL server if one is up
  ;; (reads .nrepl-port, or takes a port argument), then re-runs the same
  ;; session code under the scripted handler.
  :demo   {:main-opts ["-m" "perturb.demo"]}

  ;; Differential oracle: perturb's bencode against jolt.nrepl's, over the
  ;; profile where the two overlap.
  :oracle {:main-opts ["-m" "perturb.oracle"]}

  ;; Codec/octet self-tests that need no server and no socket.
  :selftest {:main-opts ["-m" "perturb.selftest"]}

  ;; The blocking-connection adapter ported from teensyp.stream, run against
  ;; the scripted handler at every chunk boundary from one octet upward.
  ;; No server and no socket.
  :stream {:main-opts ["-m" "perturb.streamdemo"]}

  ;; The refinement decision procedure, alone, with its boundary as a table:
  ;; every case that must be decided and every case that must be REFUSED.
  ;; `perturb.check` is the consumer; this runs the arithmetic on its own.
  :refine {:main-opts ["-m" "perturb.refine"]}

  ;; The no-I/O verifier for INHERITED I11. Runs a complete scripted session
  ;; between two marker lines and reports the instrumented native-call log.
  ;; `dev/verify-noio.sh` straces it and checks the marked window is empty.
  ;; `-M:noio --touch-native` is the positive control.
  :noio   {:main-opts ["-m" "perturb.noio"]}

  ;; The measurement of code perturb did NOT write: perturb.stream, ported from
  ;; teensyp.stream by an agent forbidden to read the rules, checked against a
  ;; declaration written from outside. Not a gate — it records no expectations,
  ;; because the point was to find out the verdicts rather than assert them.
  ;; (This alias was missing when the measurement landed, which made it
  ;; unreachable from the documented interface; found by the -M:evt work.)
  :streamcheck {:main-opts ["-m" "perturb.streamcheck"]}

  ;; PERTURB-DESIGN §1.1's SECOND IR claim (`:host`/`:host-static`/`:host-new`/
  ;; `:host-call` should collapse into one `:extern` carrying an effect row and
  ;; signature), measured over real Jolt IR from Jolt's stdlib and all of
  ;; perturb. NOT a gate: it records no expectations, it reports counts and node
  ;; shapes. No socket, no server; nothing in the corpus is called.
  :extern {:main-opts ["-m" "perturb.externprobe"]}

  ;; The static capability checker. Reads perturb.cap's declarations as a
  ;; SPECIFICATION and real Jolt IR as the program, and rejects. No socket and
  ;; no server; nothing in the corpus is ever called.
  :check  {:main-opts ["-m" "perturb.check"]}

  ;; perturb's SECOND protocol: an HTTP/1.1 keep-alive server driver run under
  ;; the scripted network (one octet per recv) and under a real POSIX listening
  ;; socket, with the response octets compared. Takes a port; needs no server,
  ;; because it is both ends.
  :http   {:main-opts ["-m" "perturb.httpdemo"]}

  ;; The enumeration check behind the fail-closed boundary: every jolt.ffi
  ;; binding in perturb.posix must be one perturb.posix/defsys emitted (so it
  ;; carries its gate) or be on a named allow-list of exactly one. Reads real
  ;; Jolt IR via perturb.ir, so it matches the analyzer's :ffi-fn node rather
  ;; than a source token. `dev/verify-noio.sh` runs it as a VERDICT line.
  :gatecheck {:main-opts ["-m" "perturb.gatecheck"]}

  ;; The event-driven experiment: a driver that owns every capability and an
  ;; application that is a pure (state, event) -> [state', effects]. Checks
  ;; both namespaces and then RUNS both drivers, scripted and over a real
  ;; loopback socket. NOT a gate — it records no expectations. Takes a port.
  :evt    {:main-opts ["-m" "perturb.evtcheck"]}

  ;; The LAYERING experiment: a TLS-shaped record layer whose handler satisfies
  ;; `perturb.wire/socket` by PERFORMING `perturb.wire/socket` against the rung
  ;; below, so `perturb.http` runs unmodified over handler-over-handler rather
  ;; than call-over-call. Checks `perturb.tlsish` and then RUNS the stack,
  ;; scripted and over a real loopback socket, printing the octets that crossed
  ;; each layer. NOT a gate — it records no expectations. Takes a port.
  :tls    {:main-opts ["-m" "perturb.tlsdemo"]}

  ;; PERTURB-DESIGN §5 ladder step 1a: the jolt-tcp CLIENT connection. Compiles
  ;; casselc/jolt-tcp's real `teensyp.client` and its real test suite from a
  ;; working tree ($JOLT_TCP_ROOT), unmodified and not as a dependency, and
  ;; checks them against a capability declared from OUTSIDE in `perturb.tcpcap`.
  ;; No socket and no server; the only library code that runs is one stray
  ;; top-level form in the library's own test file, which the report prints.
  ;; NOT a gate — it records no expectations, because the point is to find out
  ;; what the verdicts are.
  :tcpcheck {:main-opts ["-m" "perturb.tcpcheck"]}

  ;; STRUCTURAL-TIER-BRIEF step 1: the BYTE-WINDOW REPRESENTATION, measured.
  ;; Per-octet access cost against six baselines, repeated-prefix CPU under
  ;; one-octet delivery, retained-buffer high-water mark, the HTTP layer's
  ;; maximum legal frame, error offset/replay, and a disabled-instrument
  ;; control. Takes a sample count (default 5). No socket and no server.
  ;; NOT a gate — it records no expectations and asserts no threshold, because
  ;; a threshold taken from one host on one Chez is the mistake E10 recorded.
  :winbench {:main-opts ["-m" "perturb.winbench"]}

  ;; PERTURB-DESIGN E33's B6 invariant, EXECUTED: a TRACE-LEVEL checker over
  ;; perturb.effect's layering event log and perturb.cap's ledger. Runs the
  ;; known-good two-rung composition and every negative control E29 built by
  ;; hand — abort laundering, call-over-call, a multi-shot outward operation —
  ;; plus PRACTICAL-ADOPTION §A3's runtime refusals and forged-trace controls.
  ;; IS A GATE: it records expectations and exits non-zero when one changes.
  ;; No socket and no server.
  :layer  {:main-opts ["-m" "perturb.layercheck"]}

  ;; E37 / tally row 56, EXECUTED: `perturb.octet/octets?` was a TAG recognizer,
  ;; so a hand-built `{:perturb.octet/octets [-1 999]}` passed the result
  ;; predicate `perturb.wire/socket` declares for `:recv` — the one check
  ;; standing between a handler's return value and the codec. Runs the forged
  ;; corpus against the effect boundary and against the recognizer, both
  ;; directions, and times the predicate because it went from O(1) to O(n).
  ;; IS A GATE: it records expectations and exits non-zero when one changes.
  ;; Takes a sample count for the timing section (default 5). No socket, no
  ;; server, no FFI.
  :octetcheck {:main-opts ["-m" "perturb.octetcheck"]}

  ;; PERTURB-DESIGN E37's reframe, EXECUTED: the TRANSITIVE SHAREABILITY RULE.
  ;; The classifier for a freely duplicable value is an INTERFACE property, and
  ;; its transitivity clause is §4.6's root cause rather than a second tier.
  ;; Runs `perturb.share`'s boundary table, its declaration rules each broken
  ;; and restored, and the survey's THREE-WAY negative control over real IR:
  ;; unrestricted persistent values must draw nothing from capability typestate,
  ;; a capability inside a persistent container must stay visible, and an
  ;; out-of-bounds read must be caught by structural reasoning instead.
  ;; IS A GATE: it records expectations and exits non-zero when one changes.
  ;; No socket and no server; nothing in arm B is ever called.
  :share  {:main-opts ["-m" "perturb.sharecheck"]}}}
