;; perturb — a namespace set running on the Jolt compiler.
;;
;; Deliberately minimal: perturb declares nothing about its semantics here.
;; See docs/SHAREABLE.md S2 — deps resolution is semantics-neutral and this
;; file is evidence of how little of it perturb needs.
{:paths ["src"]

 :aliases
 {;; The claims demo. Talks to a real jolt nREPL server if one is up
  ;; (reads .nrepl-port, or takes a port argument), then re-runs the same
  ;; session code under the scripted handler.
  :demo   {:main-opts ["-m" "perturb.demo"]}

  ;; Differential oracle: perturb's bencode against jolt.nrepl's, over the
  ;; profile where the two overlap.
  :oracle {:main-opts ["-m" "perturb.oracle"]}

  ;; Codec/octet self-tests that need no server and no socket.
  :selftest {:main-opts ["-m" "perturb.selftest"]}

  ;; The no-I/O verifier for INHERITED I11. Runs a complete scripted session
  ;; between two marker lines and reports the instrumented native-call log.
  ;; `dev/verify-noio.sh` straces it and checks the marked window is empty.
  ;; `-M:noio --touch-native` is the positive control.
  :noio   {:main-opts ["-m" "perturb.noio"]}

  ;; The static capability checker. Reads perturb.cap's declarations as a
  ;; SPECIFICATION and real Jolt IR as the program, and rejects. No socket and
  ;; no server; nothing in the corpus is ever called.
  :check  {:main-opts ["-m" "perturb.check"]}

  ;; perturb's SECOND protocol: an HTTP/1.1 keep-alive server driver run under
  ;; the scripted network (one octet per recv) and under a real POSIX listening
  ;; socket, with the response octets compared. Takes a port; needs no server,
  ;; because it is both ends.
  :http   {:main-opts ["-m" "perturb.httpdemo"]}}}
